{
  "name": "@videodock/tile-slider",
  "version": "2.2.0",
  "repository": {
    "url": "https://github.com/Videodock/tile-slider"
  },
  "bugs": {
    "url": "https://github.com/Videodock/tile-slider/issues"
  },
  "main": "lib/index.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf lib",
    "build": "rollup -c --bundleConfigAsCjs",
    "prepublishOnly": "yarn clean && yarn build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md && node ./scripts/gh-release.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "confusing-browser-globals": "^1.0.11",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-rulesdir": "^0.2.2",
    "new-github-release-url": "^2.0.0",
    "open": "^10.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "rollup": "^4.28.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-import-css": "^3.5.7",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  }
}
